<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.SpaceMapper">

    <resultMap id="BaseResultMap" type="Space">
        <id column="id" property="id" />
        <result column="space_name" property="spaceName" />
        <result column="space_level" property="spaceLevel" />
        <result column="space_type" property="spaceType" />
        <result column="max_size" property="maxSize" />
        <result column="max_count" property="maxCount" />
        <result column="total_size" property="totalSize" />
        <result column="total_count" property="totalCount" />
        <result column="user_id" property="userId" />
        <result column="create_time" property="createTime" />
        <result column="edit_time" property="editTime" />
        <result column="update_time" property="updateTime" />
        <result column="delete_time" property="deleteTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id,
        space_name,
        space_level,
        space_type,
        max_size,
        max_count,
        total_size,
        total_count,
        user_id,
        create_time,
        edit_time,
        update_time,
        delete_time
